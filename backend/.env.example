# Copie ce fichier en .env et remplis les valeurs

# Clé API DeepL officielle (gratuite jusqu'à 500 000 caractères/mois)
# -> https://www.deepl.com/fr/pro-api
DEEPL_API_KEY=

# URL de FlareSolverr (lancé via docker-compose, ne change normalement pas)
FLARESOLVERR_URL=http://localhost:8191/v1

# URL Redis (lancé via docker-compose, ne change normalement pas)
REDIS_URL=redis://localhost:6379/0

# Dossier où sont stockés tous les résultats (scripts, jobs, sous-titres...)
STORAGE_DIR=./storage

# Dossier contenant tes scripts existants du module 03 (Transcript YTB)
# Chemin relatif au dossier backend/ (pas besoin d'y toucher si tu gardes
# la structure du repo telle quelle)
SUBTITLES_SCRIPTS_DIR=legacy_scripts/subtitles

# Origines autorisées à appeler l'API (ton frontend Next.js)
CORS_ORIGINS=["http://localhost:3000"]
